# App Configuration
APP_NAME=PNG Converter App
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/png_converter_db

# JWT & Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRE_HOURS=1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# File Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=10

# Allowed Formats
ALLOWED_OUTPUT_FORMATS=stl,svg,dxf

# Email (SMTP) - Optional, leave empty for mock mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@pngconverter.app
EMAILS_FROM_NAME=PNG Converter App

# WhatsApp (Twilio) - Optional, leave empty for mock mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Frontend URL
FRONTEND_URL=http://localhost:5173
