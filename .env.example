# ─────────────────────────────────────────────────
# PNG Converter App — Environment Variables Example
# Salin file ini ke .env dan isi nilai yang sesuai
# ─────────────────────────────────────────────────

# App
APP_NAME="PNG Converter App"
APP_VERSION="1.0.0"
DEBUG=false

# Database PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/png_converter_db

# JWT — ganti dengan random string yang kuat di production!
SECRET_KEY=your-super-secret-key-minimum-32-characters-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRE_HOURS=1

# CORS — pisahkan dengan koma
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# File Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=10

# Email SMTP (kosongkan untuk mode mock/log saja)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@pngconverter.app
EMAILS_FROM_NAME="PNG Converter App"
FRONTEND_URL=http://localhost:5173
